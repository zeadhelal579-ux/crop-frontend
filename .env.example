# true (default) = answer every REST call from the in-browser mock API, so the app
# runs with NO backend (for example on Vercel). Set "false" once the C# backend is live.
VITE_USE_MOCKS=true

# Base URL of the ASP.NET Core backend (REST and the SignalR hub share it).
# Only used when VITE_USE_MOCKS=false.
VITE_API_BASE_URL=https://api.crop.app

# Google OAuth "Web application" client id for Sign in with Google (public value, not a secret).
# Looks like 1234567890-abc123.apps.googleusercontent.com. While it is missing, the login page
# offers the shared demo account instead. See README, section "Google sign-in".
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Google Maps JavaScript API key (public value - restrict it by HTTP referrer in Google Cloud).
# Looks like AIza.... While it is missing, the farm map falls back to the built-in SVG map.
# See README, section "Google Maps".
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Application id of the third-party live-chat vendor (ADR-021).
VITE_CHAT_WIDGET_APP_ID=your_chat_vendor_app_id_here
